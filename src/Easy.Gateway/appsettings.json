{
  "ReverseProxy": {
    "Routes": {
      "exam-room-hub": {
        "ClusterId": "exam-room",
        "Match": { "Path": "/hubs/exam-room/{**rest}" }
      },
      "main-api": {
        "ClusterId": "main-api",
        "Match": { "Path": "/{**rest}" }
      },
      "main-api-upload": {
        "ClusterId": "main-api",
        "Match": { "Path": "/api/participants/{id}/documents", "Methods": [ "POST" ] }
      },
      "main-api-health": {
        "ClusterId": "main-api",
        "Match": { "Path": "/health/main-api" },
        "Transforms": [ { "PathSet": "/health" } ]
      },
      "exam-room-health": {
        "ClusterId": "exam-room",
        "Match": { "Path": "/health/exam-room" },
        "Transforms": [ { "PathSet": "/health" } ]
      }
    },
    "Clusters": {
      "main-api": {
        "Destinations": { "main-api": { "Address": "http://main-api:8080" } }
      },
      "exam-room": {
        // Cluster-level only in YARP. Idle hub WebSockets outlive the 100 s default: browsers send no pings of their own.
        "HttpRequest": { "ActivityTimeout": "00:30:00" },
        "Destinations": { "exam-room": { "Address": "http://exam-room:8080" } }
      }
    }
  }
}
