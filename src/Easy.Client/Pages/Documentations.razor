@page "/cycles/{CycleId:guid}"
@inject IAccessTokenProvider Tokens
@inject HttpClient Http

<PageTitle>Dokumentationen</PageTitle>

@* S05, S06 (issues 35, 51): a cycle's documentations with their registrations. Not live (issue 38): refetched after
   the caller's own action only. *@
<AuthorizeView Roles="examiner">
    <Authorized>
        <h1>Dokumentationen</h1>
        <p><a href="">Zurück</a></p>
        @if (message is not null)
        {
            <p role="alert">@message</p>
        }
        @if (rows is null)
        {
            @if (message is null)
            {
                <p>Lädt …</p>
            }
        }
        else
        {
            <table>
                <thead><tr><th>Nr.</th><th>Name</th><th>Status</th><th>Prüfer</th><th></th><th></th></tr></thead>
                <tbody>
                    @foreach (var row in rows)
                    {
                        <tr>
                            <td>@row.DisplayNo</td>
                            <td>@(row.Name ?? "(gelöscht)")</td>
                            <td>@Status(row.DocumentationStatus)</td>
                            <td>@string.Join(", ", row.Examiners)</td>
                            <td>
                                @if (row.Name is null || row.DocumentationStatus == "Graded")
                                {
                                    @* forgotten (S02) or graded (final): the server refuses both *@
                                }
                                else if (row.Registered)
                                {
                                    <button disabled="@busy" @onclick="() => Change(row, HttpMethod.Delete)">Abmelden</button>
                                }
                                else if (row.Examiners.Count < 2)
                                {
                                    <button disabled="@busy" @onclick="() => Change(row, HttpMethod.Post)">Anmelden</button>
                                }
                                else
                                {
                                    <span>Voll</span>
                                }
                            </td>
                            <td><a href="participants/@row.Id/grading">Bewerten</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </Authorized>
    <NotAuthorized><p>Nur für Prüfer.</p></NotAuthorized>
</AuthorizeView>

@code {
    record Row(Guid Id, string DisplayNo, string? Name, string? DocumentationStatus, List<string> Examiners, bool Registered);
    record Problem(string? Detail);

    [Parameter] public Guid CycleId { get; set; }

    List<Row>? rows;
    string? message;
    bool busy;

    protected override Task OnParametersSetAsync() => Load();

    async Task Load()
    {
        var response = await Send(new(HttpMethod.Get, $"api/cycles/{CycleId}/documentations"));
        if (response is null)
            return;
        if (response.IsSuccessStatusCode)
            rows = await response.Content.ReadFromJsonAsync<List<Row>>();
        else
            message = $"Fehler ({(int)response.StatusCode})";
    }

    // Register (POST) or unregister (DELETE), then refetch: others may have changed the list meanwhile.
    async Task Change(Row row, HttpMethod method)
    {
        busy = true;
        message = null;
        try
        {
            var response = await Send(new(method, $"api/participants/{row.Id}/registration"));
            if (response is { IsSuccessStatusCode: false })
                message = (response.Content.Headers.ContentType?.MediaType == "application/problem+json"
                    ? (await response.Content.ReadFromJsonAsync<Problem>())?.Detail : null) ?? $"Fehler ({(int)response.StatusCode})";
            await Load();
        }
        finally
        {
            busy = false;
        }
    }

    static string Status(string? status) => status switch
    {
        null => "keine Dokumentation",
        "Submitted" => "eingereicht",
        "InProgress" => "in Bewertung",
        "Graded" => "bewertet",
        _ => status,
    };

    // Null when no token is available (the redirect to login is the framework's).
    async Task<HttpResponseMessage?> Send(HttpRequestMessage request)
    {
        if (!(await Tokens.RequestAccessToken()).TryGetToken(out var token))
            return null;
        request.Headers.Authorization = new("Bearer", token.Value);
        return await Http.SendAsync(request);
    }
}
