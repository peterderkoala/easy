{
  "realm": "easy",
  "enabled": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "examiner" },
      { "name": "admin", "composite": true, "composites": { "realm": ["examiner"] } }
    ]
  },
  "scopeMappings": [
    { "client": "easy-web", "roles": ["examiner", "admin"] }
  ],
  "clients": [
    {
      "clientId": "easy-web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": ["http://localhost:8080/*", "http://127.0.0.1:8080/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*##http://127.0.0.1:8080/*"
      },
      "protocolMappers": [
        {
          "name": "audience easy-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "easy-api", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "flat roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "easy-api",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "easy-notification",
      "publicClient": false,
      "secret": "${NOTIFICATION_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "audience easy-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "easy-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "easy-scheduler",
      "publicClient": false,
      "secret": "${SCHEDULER_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "audience easy-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "easy-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@easy.local",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["admin"]
    },
    {
      "username": "examiner",
      "enabled": true,
      "email": "examiner@easy.local",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Examiner",
      "credentials": [{ "type": "password", "value": "examiner", "temporary": false }],
      "realmRoles": ["examiner"]
    }
  ]
}
