    <ProjectReference Include="..\..\src\Easy.MainApi\Easy.MainApi.csproj" Aliases="mainapi" />
    <ProjectReference Include="..\..\src\Easy.ExamRoom\Easy.ExamRoom.csproj" Aliases="examroom" />
