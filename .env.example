# Copy to .env (gitignored). Dev placeholders only; never commit real values.
POSTGRES_USER=easy
POSTGRES_PASSWORD=change-me
RABBITMQ_USER=easy
RABBITMQ_PASSWORD=change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Token issuer as the browser sees it (KC_HOSTNAME in compose.dev.yml); services fetch keys via keycloak:8080.
KEYCLOAK_AUTHORITY=http://localhost:8081/realms/easy
# Imported into the realm through placeholders, so the services and Keycloak share them.
NOTIFICATION_CLIENT_SECRET=change-me
SCHEDULER_CLIENT_SECRET=change-me
SEAWEEDFS_TAG=4.48
# SeaweedFS S3 admin identity; main-api signs with it.
SEAWEEDFS_ACCESS_KEY=change-me
SEAWEEDFS_SECRET_KEY=change-me
UPLOAD_MAX_BYTES=15728640
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=easy@localhost
SMTP_ENABLE_SSL=false
